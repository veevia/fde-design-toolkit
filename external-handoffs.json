{
  "rule": "The FDE toolkit owns the product question and required evidence; the receiving specialist owns implementation and returns findings against that contract.",
  "handoffs": [
    {
      "id": "workshop-facilitation",
      "when": "A multi-person workshop is the chosen method rather than an individual FDE workflow.",
      "requestMustInclude": [
        "decision to close",
        "participants and decider",
        "available time",
        "required output"
      ],
      "returnMustInclude": [
        "agenda",
        "roles",
        "decision method",
        "artifact locations"
      ]
    },
    {
      "id": "agent-development",
      "when": "The approved AI experience spec requires prompt packaging, runtime orchestration, tools, or protocol implementation.",
      "requestMustInclude": [
        "approved REQ and AC IDs",
        "tool and data contracts",
        "human commitment boundaries",
        "evaluation cases"
      ],
      "returnMustInclude": [
        "implementation trace map",
        "unsupported requirements",
        "runtime test evidence",
        "open technical decisions"
      ]
    },
    {
      "id": "engineering-review",
      "when": "Prototype or production code needs correctness, maintainability, debugging, performance, or code-level test review.",
      "requestMustInclude": [
        "affected REQ and AC IDs",
        "reproduction or acceptance path",
        "known deviations",
        "environment"
      ],
      "returnMustInclude": [
        "findings ordered by severity",
        "evidence or reproduction",
        "requirements affected",
        "residual risk"
      ]
    },
    {
      "id": "design-tool-integration",
      "when": "Approved tokens, components, or frames must cross a vendor-specific design-tool boundary.",
      "requestMustInclude": [
        "source file and node identifiers",
        "required assets or tokens",
        "destination contract",
        "freshness expectation"
      ],
      "returnMustInclude": [
        "retrieved identifiers",
        "version or timestamp",
        "mapping report",
        "missing assets"
      ]
    },
    {
      "id": "security-review",
      "when": "The concept handles sensitive data, identity, permissions, consequential actions, or untrusted model and tool output.",
      "requestMustInclude": [
        "data classes",
        "trust boundaries",
        "actions and permissions",
        "abuse cases",
        "affected REQ IDs"
      ],
      "returnMustInclude": [
        "threat findings",
        "required mitigations",
        "blocked behaviors",
        "residual risk owner"
      ]
    },
    {
      "id": "engineering-delivery",
      "when": "An approved experience is moving from validated prototype to staged production delivery.",
      "requestMustInclude": [
        "approved acceptance criteria",
        "experiment measures and guardrails",
        "rollout population",
        "rollback triggers"
      ],
      "returnMustInclude": [
        "instrumentation map",
        "staged rollout plan",
        "rollback mechanism",
        "production evidence owner"
      ]
    }
  ]
}
